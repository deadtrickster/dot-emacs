#!/usr/bin/env bash
# Stage a command in a byobu tab WITHOUT running it -- the inverse of `esh'.
# When Claude shouldn't auto-run something (a big/risky command the human wants
# to eyeball first), instead of executing it TYPES the text into a chosen byobu
# window and STOPS -- no Enter.  The user switches there (C-t <tab>), reads it,
# edits if they like, and presses Enter themselves.
#
#   etab <window> "text"        stage literal TEXT in the <window> tab
#   etab <window> -F <file>     stage the contents of FILE -- use this for big or
#                               multi-line commands: a lone command, so it stays
#                               matched by Bash(etab:*) and never trips a prompt,
#                               and avoids quoting a huge string on the CLI.
#
# It must have NO way to execute itself:
#   * never sends Enter/Return;
#   * strips CR (the actual Enter byte), ESC, and every other control char except
#     tab -- so the payload can't smuggle the bracketed-paste terminator and
#     "break out" to run, and `$(...)' drops any trailing newline so nothing
#     dangles as a submit;
#   * pastes via tmux BRACKETED paste (`paste-buffer -p'), so even internal
#     newlines land as literal text in the line editor, not command submissions.
# Allowlist: Bash(etab:*)
set -euo pipefail

win="${1:-}"
[ -n "$win" ] || {
    echo "usage: etab <window> \"text\" | etab <window> -F <file>" >&2
    exit 2
}
shift

# --- gather the text ---------------------------------------------------------
if [ "${1:-}" = "-F" ]; then
    file="${2:?usage: etab <window> -F <file>}"
    [ -r "$file" ] || {
        echo "etab: cannot read $file" >&2
        exit 1
    }
    text=$(cat -- "$file")
else
    text="$*"
fi
[ -n "$text" ] || {
    echo "etab: nothing to stage" >&2
    exit 2
}

# --- resolve the target session/window --------------------------------------
sess=$(tmux display-message -p '#S' 2>/dev/null || true)
if [ -z "$sess" ]; then # not inside tmux -> derive like `bb'
    raw="${PROJECTILE_PROJECT_NAME:-$(basename "$(git -C "$PWD" rev-parse --show-toplevel 2>/dev/null || echo "$PWD")")}"
    sess="projectile/${raw//[.: ]/_}"
fi
tmux has-session -t "=$sess" 2>/dev/null ||
    {
        echo "etab: no byobu session '$sess'" >&2
        exit 1
    }
tmux list-windows -t "=$sess" -F '#{window_name}' 2>/dev/null | grep -qxF -- "$win" ||
    {
        echo "etab: no '$win' window in $sess (open it first)" >&2
        exit 1
    }

# --- sanitize: no way to execute itself -------------------------------------
# Drop every control byte except tab (\011) and newline (\012): NUL..BS,
# VT..US (covers CR \015 and ESC \033), and DEL.  `$(...)' also strips a
# trailing newline.  Internal newlines survive as literal line breaks.
clean=$(printf '%s' "$text" | LC_ALL=C tr -d '\000-\010\013-\037\177')
[ -n "$clean" ] || {
    echo "etab: nothing left to stage after sanitization" >&2
    exit 2
}

# --- paste (bracketed, no Enter) --------------------------------------------
buf="etab-$$"
tmux set-buffer -b "$buf" -- "$clean"
tmux paste-buffer -p -d -b "$buf" -t "=$sess:$win"

esay "staged a command in the '$win' tab -- review (C-t $win) & press Enter to run" 2>/dev/null || true
echo "etab: staged in $sess:$win (NOT executed -- the user reviews & runs it)"
