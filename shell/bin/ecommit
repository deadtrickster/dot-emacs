#!/usr/bin/env bash
# Open a commit buffer in the user's Emacs, pre-filled with the message, for the
# STAGED changes -- they review and finish (C-c C-c) or abort (C-c C-k).  This is
# how commits are made here: prepared + reviewed in Emacs, never `git commit -m'
# blind.  Stage first (git add ...).  Message from: args, `-F FILE', or stdin.
#
# The message is written to <gitdir>/ECOMMIT_MSG (overwritten each run, lives in
# .git) and only its PATH is passed to Emacs -- the message text is never
# shell-interpolated, so backticks/quotes/$ in it are safe.  `my-magit-commit'
# runs `git commit -e -F <that file>' via magit/with-editor.
# Allowlist: Bash(ecommit:*)
set -euo pipefail
msgfile="$(git rev-parse --absolute-git-dir)/ECOMMIT_MSG"
if [ "${1:-}" = "-F" ]; then
    cat -- "$2" >"$msgfile"
elif [ "$#" -gt 0 ]; then
    printf '%s\n' "$*" >"$msgfile"
else cat >"$msgfile"; fi
exec emacsclient -e "(my-magit-commit \"$msgfile\" \"$PWD\")" >/dev/null
