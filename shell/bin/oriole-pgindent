#!/usr/bin/env bash
# apheleia formatter: format OrioleDB C on stdin via pgindent -> stdout, so
# pgindent can be used like gofmt (format-on-save).  pgindent is a perl wrapper
# around `pg_bsd_indent' that edits files in place and needs a typedefs list;
# this adapts it to the stdin->stdout shape apheleia wants.
#
# Usage: oriole-pgindent <buffer-file-path>   (buffer content on stdin)
#
# `pgindent' + `pg_bsd_indent' must be on PATH (install once).  The typedefs list
# is taken from the file's repo root (orioledb.typedefs; regenerate occasionally
# with `make USE_PGXS=1 orioledb.typedefs').  Runs in a private temp DIR because
# pgindent drops `pgsrcXXXX.BAK' scratch files in its CWD -- apheleia runs us
# inside the repo, so isolating + nuking the dir keeps the project clean.  On ANY
# problem it emits the input unchanged -- a safe no-op for apheleia.
set -euo pipefail

src="${1:-$PWD}"

# No toolchain -> passthrough (harmless on a machine without the pg build).
if ! command -v pgindent >/dev/null 2>&1 || ! command -v pg_bsd_indent >/dev/null 2>&1; then
    cat; exit 0
fi

repo=$(git -C "$(dirname "$src")" rev-parse --show-toplevel 2>/dev/null || true)
td=()
[ -n "$repo" ] && [ -f "$repo/orioledb.typedefs" ] && td=(--typedefs="$repo/orioledb.typedefs")

work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT
cat > "$work/orig.c"
cp "$work/orig.c" "$work/in.c"

# pgindent edits in.c in place (and litters .BAK here, not the repo); emit it on
# success, the pristine input on any failure so a broken run never corrupts the
# buffer.
if ( cd "$work" && pgindent "${td[@]}" in.c ) >/dev/null 2>&1; then
    cat "$work/in.c"
else
    cat "$work/orig.c"
fi
