#!/usr/bin/env bash
# Post a message into the user's running Emacs (echo area).  Goes through
# emacsclient, so unlike the escape-sequence interactive `say' it works from a
# captured-stdout shell (leticode's Bash tool) -- the escape would be eaten by
# the tool's output capture instead of reaching ghostel.  Vendored; symlinked
# onto PATH by `my-ensure-shell-integration'.  Pre-approved by the `esay*` rule in ~/.config/letibot/permission.json.
set -euo pipefail
msg="$*"
esc=$(printf '%s' "$msg" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g')
exec emacsclient -e "(message \"%s\" \"$esc\")" >/dev/null
